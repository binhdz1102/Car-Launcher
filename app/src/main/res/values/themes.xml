<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CarLauncher" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/launcher_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/launcher_surface</item>
        <item name="android:navigationBarColor">@color/launcher_surface</item>
        <item name="android:colorAccent">@color/launcher_accent</item>
    </style>

    <style name="Theme.CarLauncher.AppGrid" parent="Theme.CarLauncher" />
    <style name="Theme.CarLauncher.Recents" parent="Theme.CarLauncher" />
    <style name="Theme.CarLauncher.CalmMode" parent="Theme.CarLauncher">
        <item name="android:windowBackground">@color/calm_surface</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="Theme.CarLauncher.WidgetHost" parent="Theme.CarLauncher" />
    <style name="Theme.CarLauncher.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert" />
</resources>
