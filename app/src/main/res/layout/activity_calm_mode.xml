<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calm_mode_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calm_surface"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/calm_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EE, MMM dd"
            android:format24Hour="EE, MMM dd"
            android:textColor="@color/launcher_text_secondary"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  &#8226;  "
            android:textColor="@color/launcher_text_secondary"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/calm_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/launcher_text_secondary"
            android:textSize="24sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextClock
        android:id="@+id/calm_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:format12Hour="hh:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/calm_clock"
        android:textSize="300sp"
        android:textStyle="normal" />

    <TextView
        android:id="@+id/calm_media_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|center_vertical"
        android:layout_marginTop="240dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/launcher_text_secondary"
        android:textSize="24sp"
        android:visibility="gone" />
</FrameLayout>
