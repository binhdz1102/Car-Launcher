<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calm_surface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/calm_media_source"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/launcher_accent"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/calm_media_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/white"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/calm_previous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/media_previous" />

        <Button
            android:id="@+id/calm_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/media_play" />

        <Button
            android:id="@+id/calm_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/media_next" />
    </LinearLayout>

    <Button
        android:id="@+id/calm_media_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/open_media_center" />

    <Button
        android:id="@+id/calm_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/calm_mode_close" />
</LinearLayout>
