<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:layout_margin="8dp"
    android:background="@drawable/launcher_app_tile"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="20dp">

    <ImageView
        android:id="@+id/recent_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/recent_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/launcher_text_primary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/recent_remove"
        android:layout_width="96dp"
        android:layout_height="48dp"
        android:background="@drawable/launcher_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Remove"
        android:textColor="@color/launcher_text_primary"
        android:textSize="14sp" />
</LinearLayout>
