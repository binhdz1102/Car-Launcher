<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_surface"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recent tasks"
        android:textColor="@color/launcher_text_primary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/recents_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No recent tasks"
        android:textColor="@color/launcher_text_secondary"
        android:textSize="20sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recents_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="24dp" />

    <TextView
        android:id="@+id/recents_clear_all"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/launcher_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Clear all"
        android:textColor="@color/launcher_text_primary"
        android:textSize="17sp" />
</LinearLayout>
