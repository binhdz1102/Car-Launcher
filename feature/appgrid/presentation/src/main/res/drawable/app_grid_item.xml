<?xml version="1.0" encoding="utf-8"?>
<!--
    AOSP creates the item highlight as a transparent transition layer.  A focused
    tile is not painted merely because the RecyclerView enters rotary focus; the
    visible highlight is driven by drag targeting.  Keeping the default layer
    transparent avoids a false focus ring in HOME/App Grid screenshots while
    preserving focusability for rotary navigation.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@android:color/transparent" />
</shape>
