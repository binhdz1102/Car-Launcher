<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/app_item"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/app_grid_item"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@id/app_icon"
        android:layout_gravity="center"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/app_icon_background"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@id/app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/app_grid_text_primary"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/app_grid_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/app_grid_text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
