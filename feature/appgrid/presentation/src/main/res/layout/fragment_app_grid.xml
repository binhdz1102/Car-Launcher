<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_grid_background"
    android:paddingHorizontal="56dp"
    android:paddingVertical="24dp">

    <TextView
        android:id="@+id/app_grid_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/app_grid_title"
        android:textColor="@color/app_grid_text_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/app_grid_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/app_grid_close"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/app_grid_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="96dp"
        android:text="@string/app_grid_close"
        android:textColor="@color/app_grid_text_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/app_grid_search"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/app_grid_search"
        android:hint="@string/app_grid_search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="20dp"
        android:singleLine="true"
        android:textColor="@color/app_grid_text_primary"
        android:textColorHint="@color/app_grid_text_secondary"
        android:textSize="18sp"
        app:layout_constraintEnd_toStartOf="@id/app_grid_reorder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_grid_title" />

    <TextView
        android:id="@+id/app_grid_reorder"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/app_grid_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="140dp"
        android:paddingHorizontal="16dp"
        android:text="@string/app_grid_reorder"
        android:textColor="@color/app_grid_text_primary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_grid_close" />

    <LinearLayout
        android:id="@+id/tos_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/app_grid_tos_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_grid_search">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_grid_tos_message"
            android:textColor="@color/app_grid_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tos_review"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/app_grid_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/app_grid_tos_review"
            android:textColor="@color/app_grid_text_primary" />

        <TextView
            android:id="@+id/tos_dismiss"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/app_grid_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/app_grid_tos_not_now"
            android:textColor="@color/app_grid_text_primary" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/app_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tos_banner" />

    <TextView
        android:id="@+id/app_grid_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_grid_empty"
        android:textColor="@color/app_grid_text_secondary"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/app_grid"
        app:layout_constraintEnd_toEndOf="@id/app_grid"
        app:layout_constraintStart_toStartOf="@id/app_grid"
        app:layout_constraintTop_toTopOf="@id/app_grid" />
</androidx.constraintlayout.widget.ConstraintLayout>
