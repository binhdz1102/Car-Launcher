<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/recents_task_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="168dp"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/recent_thumbnail"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_weight="1.6"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/recent_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recent_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/recents_text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/recent_disabled_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/recents_disabled_reason"
            android:textColor="@color/recents_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/recent_remove"
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:background="@drawable/recents_button_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/recents_remove"
        android:textColor="@color/recents_text_primary"
        android:textSize="14sp" />
</LinearLayout>
