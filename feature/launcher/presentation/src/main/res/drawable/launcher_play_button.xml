<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@color/launcher_button_disabled" /><corners android:radius="40dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#B3E1FF" /><corners android:radius="40dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/launcher_accent" /><corners android:radius="40dp" /></shape>
    </item>
</selector>
