<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="168dp"
    android:layout_margin="8dp"
    android:background="@drawable/launcher_app_tile"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="20dp">

    <ImageView
        android:id="@+id/recent_thumbnail"
        android:layout_width="220dp"
        android:layout_height="128dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/recent_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recent_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/launcher_text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/recent_disabled_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_disabled_not_distraction_optimized"
            android:textColor="@color/launcher_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/recent_remove"
        android:layout_width="96dp"
        android:layout_height="48dp"
        android:background="@drawable/launcher_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/recents_remove"
        android:textColor="@color/launcher_text_primary"
        android:textSize="14sp" />
</LinearLayout>
